[submodule "hook-dsh-normalize-file"]
	path = Classic/packages/hook-dsh-normalize-file
	url = https://github.com/PlayForm/hook-dsh-normalize-file.git

[submodule "hook-dsh-normalize-fullwidth"]
	path = Classic/packages/hook-dsh-normalize-fullwidth
	url = https://github.com/PlayForm/hook-dsh-normalize-fullwidth.git

[submodule "hook-dsh-normalize-invisible"]
	path = Classic/packages/hook-dsh-normalize-invisible
	url = https://github.com/PlayForm/hook-dsh-normalize-invisible.git

[submodule "hook-dsh-normalize-quotes"]
	path = Classic/packages/hook-dsh-normalize-quotes
	url = https://github.com/PlayForm/hook-dsh-normalize-quotes.git

[submodule "hook-dsh-normalize-spaces"]
	path = Classic/packages/hook-dsh-normalize-spaces
	url = https://github.com/PlayForm/hook-dsh-normalize-spaces.git

[submodule "hook-dsh-pinner-package"]
	path = Classic/packages/hook-dsh-pinner-package
	url = https://github.com/PlayForm/hook-dsh-pinner-package.git

[submodule "plugin-dsh-factory"]
	path = Classic/packages/plugin-dsh-factory
	url = https://github.com/PlayForm/plugin-dsh-factory.git

