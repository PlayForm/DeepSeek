# ============================================================
# .gitmodules DRAFT - the submodule preparation (#16).
#
# This file is a PROPOSAL: it is NOT active (git does not read it
# under this name). The plan: each release package becomes a
# separate repository (github.com/PlayForm/<package-name>), added
# back as a git submodule at its current package directory.
#
# To activate (the user runs, per entry):
#
#   git submodule add https://github.com/PlayForm/<package-name>.git \
#       Classic/packages/<package-dir>   # (or EffectTS/packages/...)
#
# then rename this file to .gitmodules (or let `git submodule add`
# regenerate the entries). Do NOT activate before the per-package
# repositories exist.
#
# Naming note (pending the lib-/manifest refinement, #15): the two
# flavors publish the SAME npm names (@playform/<package-name>), so
# the draft repo names are <package-name> for the Classic flavor and
# <package-name>-effectts for the Effect-TS flavor; the suffix is a
# placeholder until the naming is decided.
#
# The per-package .gitignore files (node_modules/, Target/,
# pnpm-lock.yaml, ...) already anticipate the extraction: once each
# package is its own repository, its own .gitignore governs its
# contents.
# ============================================================

# ---- Classic/packages ----

[submodule "hook-dsh-core"]
	path = Classic/packages/hook-dsh-core
	url = https://github.com/PlayForm/hook-dsh-core.git

[submodule "hook-dsh-governor-cargo"]
	path = Classic/packages/hook-dsh-governor-cargo
	url = https://github.com/PlayForm/hook-dsh-governor-cargo.git

