	path = Classic/packages/dsh-hook-normalize-ellipsis
	url = https://github.com/PlayForm/dsh-hook-normalize-ellipsis.git

[submodule "dsh-hook-normalize-file"]
	path = Classic/packages/dsh-hook-normalize-file
	url = https://github.com/PlayForm/dsh-hook-normalize-file.git

[submodule "dsh-hook-normalize-fullwidth"]
	path = Classic/packages/dsh-hook-normalize-fullwidth
	url = https://github.com/PlayForm/dsh-hook-normalize-fullwidth.git

[submodule "dsh-hook-normalize-invisible"]
	path = Classic/packages/dsh-hook-normalize-invisible
	url = https://github.com/PlayForm/dsh-hook-normalize-invisible.git

[submodule "dsh-hook-normalize-quotes"]
	path = Classic/packages/dsh-hook-normalize-quotes
	url = https://github.com/PlayForm/dsh-hook-normalize-quotes.git

[submodule "dsh-hook-normalize-spaces"]
	path = Classic/packages/dsh-hook-normalize-spaces
	url = https://github.com/PlayForm/dsh-hook-normalize-spaces.git

[submodule "dsh-hook-package-pinner"]
	path = Classic/packages/dsh-hook-package-pinner
	url = https://github.com/PlayForm/dsh-hook-package-pinner.git

[submodule "dsh-plugin-factory"]
	path = Classic/packages/dsh-plugin-factory
	url = https://github.com/PlayForm/dsh-plugin-factory.git

