# ============================================================
# .gitmodules DRAFT - the submodule preparation (#16).
#
# This file is a PROPOSAL: it is NOT active (git does not read it
# under this name). The plan: each release package becomes a
# separate repository (github.com/PlayForm/<package-name>), added
# back as a git submodule at its current package directory.
#
# To activate (the user runs, per entry):
#
#   git submodule add https://github.com/PlayForm/<package-name>.git \
#       Classic/packages/<package-dir>   # (or EffectTS/packages/...)
#
# then rename this file to .gitmodules (or let `git submodule add`
# regenerate the entries). Do NOT activate before the per-package
# repositories exist.
#
# Naming note (decided, SPLICE-ETS §2/§5.2): the two flavors publish
# DIFFERENT npm names - the Classic flavor under @playform/dsh-* (the
# plain names) and the Effect-TS flavor under @playform/ets-* (+ the
# base @playform/ets-dsh-hook); the draft repo names are the package
# directory names (dsh-* for the Classic flavor, ets-* for the
# Effect-TS flavor, ets-dsh-hook for the base).
#
# The per-package .gitignore files (node_modules/, Target/,
# pnpm-lock.yaml, ...) already anticipate the extraction: once each
# package is its own repository, its own .gitignore governs its
# contents.
# ============================================================

# ---- Classic/packages ----

[submodule "dsh-hook-core"]
	path = Classic/packages/dsh-hook-core
	url = https://github.com/PlayForm/dsh-hook-core.git

[submodule "dsh-hook-cargo-governor"]
	path = Classic/packages/dsh-hook-cargo-governor
	url = https://github.com/PlayForm/dsh-hook-cargo-governor.git

[submodule "dsh-hook-package-governor"]
	path = Classic/packages/dsh-hook-package-governor
	url = https://github.com/PlayForm/dsh-hook-package-governor.git

