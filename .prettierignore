# ============================================================
# Prettier exclusions for the DeepSeek Harness Plugin Family
# monorepo - adapted to THIS repository's actual structure:
#   Classic/packages/*,
#   EffectTS/packages/* (each with Target/ build dirs),
#   Site/, docs/, Test/, root node_modules + pnpm-lock.
# ============================================================

# Dependencies
node_modules
**/node_modules

# Lockfiles
pnpm-lock.yaml
package-lock.json
yarn.lock

# Build output (per-package Target/ dirs + generic build trees)
Target
**/Target
**/Target/**
target
**/target
**/target/**
dist
**/dist
**/dist/**

# Caches
.cache
**/.cache
.eslintcache
**/.eslintcache
.turbo
**/.turbo

# Markdown is formatted like every other proper file. NOTE: prettier trims
# trailing two-space hard breaks and reflows prose (proseWrap: always), so
# the legacy family prose will re-render once formatted.

# The Site tree - a separate repository with its own prettier config
# (Site/prettier.config.js); the root config does not govern it.
Site
Site/**

# The generated static market index - written byte-for-byte by
# Maintain/Generate-Marketplace.mjs; prettier would break its --check.
marketplace.json

# Test fixtures - frozen by design, never reformat
Test
Test/**
