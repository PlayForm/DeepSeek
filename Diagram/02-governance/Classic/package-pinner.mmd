---
title: package-pinner - deterministic version pinning
line9:
  theme: boardroom
---
flowchart LR
  EV(["fs/observed<br>tool-layer write"]):::host
  GATE["Factory.Gate<br>basename package.json"]:::hook
  X{"gated<br>out?"}
  SKIP["skipped (excluded)"]
  DISC["Discover<br>registry walk-up"]:::hook
  KEEP["union keep-list<br>ResolvePolicy"]:::hook
  DEC["Decode JSON<br>null on failure"]:::hook
  NJ["observed non-JSON<br>skipped"]:::fail
  LAW["range law<br>strip one ^ ~ ="]:::hook
  REFU{"refusal<br>guard?"}
  NO["REFUSED line<br>no write"]:::fail
  WRITE["GuardedWrite<br>replaceIfVersion"]:::hook
  REF["Refresh<br>same actor"]:::hook
  LED[("~/.dsh/<br>hook-dsh-package-<br>pinner.log")]:::store
  SILENT["author sees own bytes<br>pinned only on disk"]
  EV ==> GATE
  GATE --> X
  X -- yes --> SKIP
  X -- no --> DISC
  DISC --> KEEP
  KEEP --> DEC
  DEC --> NJ
  DEC --> LAW
  LAW --> REFU
  REFU -- yes --> NO
  REFU -- no --> WRITE
  WRITE --> REF
  REF --> SILENT
  SKIP -.-> LED
  NJ -.-> LED
  NO -.-> LED
  WRITE -.-> LED
