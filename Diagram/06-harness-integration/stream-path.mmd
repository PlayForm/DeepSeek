flowchart LR
  REQ(["model request<br>streaming"]):::host
  STREAM["llm/stream<br>waterfall"]:::host
  F1["dash"]:::hook
  F2["quotes"]:::hook
  F3["ellipsis"]:::hook
  F4["spaces"]:::hook
  F5["invisible"]:::hook
  F6["fullwidth"]:::hook
  NOTE["each wraps the next<br>order-independent"]
  GATE{"toolArgs<br>flag?"}
  EX{"exempt<br>tool?"}
  ARGS["tool arguments<br>byte-exact"]:::hook
  REP["single-char replace<br>per chunk"]:::hook
  OUT["live UI + transcript"]:::host
  LED[("per-flavor ledger")]:::store
  REQ ==> STREAM
  STREAM --> F1
  F1 --> F2
  F2 --> F3
  F3 --> F4
  F4 --> F5
  F5 --> F6
  F6 --> GATE
  GATE -- off --> ARGS
  GATE -- on --> EX
  EX -- yes --> ARGS
  EX -- no --> REP
  REP --> OUT
  ARGS --> OUT
  F6 -.-> LED
  NOTE -.-> F1
