{
	"$schema": "https://json.schemastore.org/prettierrc",
	"plugins": ["prettier-plugin-sh"],
	"printWidth": 100,

	"useTabs": true,
	"tabWidth": 4,

	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"proseWrap": "always",

	"bracketSameLine": true,
	"quoteProps": "preserve",
	"htmlWhitespaceSensitivity": "css",
	"embeddedLanguageFormatting": "auto"
}
