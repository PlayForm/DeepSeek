{
	"name": "@playform/dsh-family-monorepo",
	"version": "0.2.0",
	"private": true,
	"description": "The DeepSeek Harness Plugin Family for PlayForm - the monorepo: the Classic release, the Effect-TS release, the Site, and the Test archive.",
	"scripts": {
		"build": "pnpm run build:classic && pnpm run build:effect-ts",
		"build:classic": "pnpm -r --workspace-concurrency=1 --filter \"./Classic/packages/**\" run prepublishOnly",
		"build:effect-ts": "pnpm -r --workspace-concurrency=1 --filter \"./EffectTS/packages/**\" run prepublishOnly",
		"format": "bash Maintain/Format/Index.sh",
		"format:check": "prettier --check --ignore-path .prettierignore . && node Maintain/Check/Newlines/Index.mjs",
		"format:newlines": "bash Maintain/Format/Index.sh newlines",
		"format:prettier": "bash Maintain/Format/Index.sh prettier",
		"icons": "node Maintain/Generate/Icons/Index.mjs",
		"icons:check": "node Maintain/Generate/Icons/Index.mjs --check",
		"lychee": "bash Maintain/Check/Lychee/Index.sh",
		"marketplace": "node Maintain/Generate/Marketplace/Index.mjs",
		"marketplace:check": "node Maintain/Generate/Marketplace/Index.mjs --check",
		"site": "pnpm --dir Site run Run",
		"test": "node Maintain/Run/Smokes/Index.mjs",
		"test:icons": "node Test/Icons/Check.mjs",
		"test:types": "node Maintain/Run/Types/Index.mjs",
		"test:wiring": "node Maintain/Run/Wiring/Index.mjs"
	},
	"devDependencies": {
		"@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@prettier/plugin-lua": "0.0.3",
		"@prettier/plugin-oxc": "0.2.3",
		"@prettier/plugin-php": "0.26.0",
		"@prettier/plugin-ruby": "4.0.4",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@vue/compiler-sfc": "3.5.44",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-autocorrect": "0.4.3",
		"prettier-plugin-ember-template-tag": "2.1.8",
		"prettier-plugin-java": "2.11.0",
		"prettier-plugin-kotlin": "2.1.0",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-packagejson": "3.0.3",
		"prettier-plugin-pkg": "0.22.1",
		"prettier-plugin-sh": "0.20.2",
		"prettier-plugin-sort-imports": "1.8.11",
		"prettier-plugin-sql": "0.20.0",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"prettier-plugin-toml": "4.1.0",
		"tailwindcss": "4.3.3"
	},
	"packageManager": "pnpm@11.18.0"
}
