# ============================================================
# pnpm settings for the DeepSeek Harness Plugin Family monorepo
# (adapted from CodeEditorLand/Land .npmrc).
# ============================================================

registry=https://registry.npmjs.org/

# Workspace behavior: a single shared lockfile and isolated
# node_modules (pnpm's default strict linking).
shared-workspace-lockfile=true
link-workspace-packages=true
prefer-workspace-packages=true

# Install behavior.
auto-install-peers=true
strict-peer-dependencies=false
prefer-frozen-lockfile=false

# Node heap for the family's build/test runs.
node-options=--max-old-space-size=4096
